{
  "name": "shell-aliasforge",
  "version": "0.1.0",
  "description": "Mine your shell history to suggest aliases and flag risky or secret-leaking commands. Local-first, offline, zero dependencies.",
  "license": "MIT",
  "author": "Pratik Surve",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prsurve/aliasforge.git"
  },
  "homepage": "https://github.com/prsurve/aliasforge#readme",
  "bugs": {
    "url": "https://github.com/prsurve/aliasforge/issues"
  },
  "type": "module",
  "bin": {
    "aliasforge": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "shell",
    "alias",
    "history",
    "cli",
    "bash",
    "zsh",
    "fish",
    "secrets",
    "offline"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
