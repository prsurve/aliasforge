{
  "name": "aliasforge",
  "version": "0.0.0",
  "description": "Mine shell history to suggest aliases and flag risky or secret-leaking commands. Local-first, offline.",
  "type": "module",
  "bin": {
    "aliasforge": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx src/cli.ts"
  },
  "keywords": [
    "shell",
    "alias",
    "history",
    "cli"
  ],
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
